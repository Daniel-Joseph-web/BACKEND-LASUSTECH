{
  "name": "lasustech-cbt",
  "private": true,
  "scripts": {
    "start": "node scripts/start-all.mjs",
    "dev": "pnpm -r run dev",
    "dev:api": "pnpm --filter @lasustech-cbt/api dev",
    "dev:worker": "pnpm --filter @lasustech-cbt/worker dev",
    "dev:realtime": "pnpm --filter @lasustech-cbt/realtime dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "db:generate": "pnpm --filter @lasustech-cbt/db run generate",
    "db:studio": "pnpm --filter @lasustech-cbt/db run studio",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "prisma",
      "@prisma/client",
      "@prisma/engines"
    ]
  }
}
