    "verify:fresh": "node scripts/rebuild-and-verify.mjs",
    "inspect": "node scripts/inspect-db.mjs",
    "dev:rebuild": "node scripts/archive-and-rebuild-dev.mjs",
    "provision:app": "node scripts/provision-app-role.mjs",
