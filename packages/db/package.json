  "prisma": {
    "seed": "ts-node --transpile-only src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
