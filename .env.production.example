# LASUSTECH CBT Backend Production Environment Configuration
NODE_ENV=production
PORT=3001

# Production PostgreSQL Connection String
DATABASE_URL=postgresql://cbt_user:CHANGE_ME_IN_PRODUCTION@localhost:5432/lasustech_cbt?schema=public

# Production Redis URL
REDIS_URL=redis://localhost:6379

# Allowed CORS Origin (Student & Admin Web Client)
WEB_ORIGIN=https://cbt.lasustech.edu.ng

# High-entropy JWT Signing Secret (must be at least 32 characters)
JWT_SECRET=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_HEX_KEY

# Media Assets Persistent Storage Path
MEDIA_UPLOAD_DIR=/var/data/lasustech-cbt/uploads/media
