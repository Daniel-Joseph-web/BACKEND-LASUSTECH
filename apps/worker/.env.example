# Copy to .env and fill in. Never commit the real file.
# Runtime connection: least-privilege cbt_app (migration 2_identity_hardening).
DATABASE_URL="postgresql://cbt_app:CHANGE_ME@localhost:5432/lasustech_cbt?schema=public"
REDIS_URL="redis://localhost:6379"

# AI provider: auto | gemini | cloudflare | ollama
# auto = Gemini, then Cloudflare, then Ollama.
AI_PROVIDER=auto

# Cloud providers (free tier preferred).
CF_ACCOUNT_ID=""
CF_API_TOKEN=""
CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CF_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-2.5-flash

# Optional local fallback (offline/dev). Unset to disable Ollama.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b-instruct

# Must match apps/api so uploaded and imported images share one store.
MEDIA_UPLOAD_DIR=../../uploads/media
