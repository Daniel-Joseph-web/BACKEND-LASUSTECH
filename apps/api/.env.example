# Copy to .env and fill in. Never commit the real file.
# Runtime connection: least-privilege cbt_app (migration 2_identity_hardening).
# Run `node packages/db/scripts/provision-app-role.mjs` to set cbt_app's password
# and rewrite this line. The API refuses to boot as a superuser.
DATABASE_URL="postgresql://cbt_app:CHANGE_ME@localhost:5432/lasustech_cbt?schema=public"

# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

WEB_ORIGIN="http://localhost:3000"
PORT=3001

# Cloudflare Workers AI — used by the question-import pipeline.
CF_ACCOUNT_ID=""
CF_API_TOKEN=""

# Shared with the worker: uploaded and imported question figures live here and
# are served from GET /api/v1/media/:id. Defaults to ../../uploads/media.
MEDIA_UPLOAD_DIR=../../uploads/media
